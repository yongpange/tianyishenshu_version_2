# Coze OAuth 2.0 配置 (新版本)
COZE_CLIENT_ID=your_client_id_here
COZE_PUBLIC_KEY_ID=your_public_key_id_here
COZE_PRIVATE_KEY_FILE=private_key_ty.pem
COZE_API_BASE=api.coze.cn

# BOT_ID 现在通过API参数动态传递，不再写死在环境变量中
# 前端可以配置默认BOT_ID
NEXT_PUBLIC_DEFAULT_CHAT_BOT_ID=7445193658986659842
NEXT_PUBLIC_PERSONALITY_BOT_ID=7445193658986659842

# Supabase 配置
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 腾讯云短信配置
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_SMS_APP_ID=your_sms_app_id
TENCENT_SMS_SIGN=your_sms_sign
TENCENT_SMS_TEMPLATE_ID=your_sms_template_id

# 旧版配置 (已弃用，仅作备用)
# COZE_API_TOKEN=your_old_api_token
# BOT_ID=your_old_bot_id
