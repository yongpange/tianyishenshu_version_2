# 天乙神算Docker环境变量配置模板
# 复制此文件为 .env.docker 并填入实际值

# ===== Docker特定配置 =====
COMPOSE_PROJECT_NAME=tianyishensuan
COMPOSE_FILE=docker-compose.yml

# ===== 应用配置 =====
APP_PORT=3000
APP_HOST=0.0.0.0

# ===== Nginx配置 =====
NGINX_PORT=80
NGINX_SSL_PORT=443

# ===== Redis配置 =====
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ===== 数据卷路径 =====
LOGS_PATH=./logs
SSL_CERTS_PATH=./nginx/ssl

# ===== 健康检查配置 =====
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ===== 资源限制 =====
APP_MEMORY_LIMIT=512m
APP_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=128m
