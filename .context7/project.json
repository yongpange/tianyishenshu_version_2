{
  "name": "天乙神算 (TianYi ShenSuan)",
  "description": "基于 Next.js 的命理分析网站，集成 Supabase 数据库和 Coze AI 智能体",
  "version": "1.0.0",
  "framework": "Next.js 14",
  "language": "TypeScript",
  "styling": "Tailwind CSS + Ant Design",
  "database": "Supabase (PostgreSQL)",
  "ai_integration": "Coze API",
  "authentication": "手机号 + 短信验证码 (腾讯云SMS)",
  
  "architecture": {
    "pattern": "App Router (Next.js 13+)",
    "state_management": "React Hooks + Supabase",
    "api_design": "RESTful API Routes",
    "deployment": "Docker + Alibaba Cloud"
  },
  
  "key_directories": {
    "src/app": {
      "description": "Next.js App Router 页面和 API 路由",
      "importance": "high",
      "contains": [
        "页面组件 (page.tsx)",
        "API 路由 (route.ts)",
        "布局组件 (layout.tsx)",
        "加载和错误页面"
      ]
    },
    "src/components": {
      "description": "可复用的 React 组件",
      "importance": "high",
      "contains": [
        "UI 组件",
        "表单组件",
        "导航组件",
        "业务逻辑组件"
      ]
    },
    "src/lib": {
      "description": "核心库和配置文件",
      "importance": "critical",
      "contains": [
        "Supabase 配置",
        "Coze AI 认证",
        "存储适配器",
        "工具函数"
      ]
    },
    "src/utils": {
      "description": "工具函数和辅助方法",
      "importance": "medium",
      "contains": [
        "数据处理",
        "格式化函数",
        "验证逻辑",
        "迁移工具"
      ]
    },
    "scripts": {
      "description": "构建、部署和维护脚本",
      "importance": "medium",
      "contains": [
        "环境检查",
        "数据库设置",
        "部署脚本"
      ]
    },
    "supabase": {
      "description": "数据库迁移和配置",
      "importance": "high",
      "contains": [
        "SQL 迁移文件",
        "RLS 策略",
        "数据库架构"
      ]
    }
  },
  
  "important_files": {
    "package.json": "项目依赖、脚本和元数据",
    "next.config.js": "Next.js 框架配置",
    "tsconfig.json": "TypeScript 编译配置",
    "tailwind.config.js": "样式框架配置",
    "src/lib/supabase.ts": "数据库连接和配置",
    "src/lib/coze-auth.ts": "AI 服务认证逻辑",
    "src/lib/storage-adapter.ts": "数据存储抽象层",
    "src/utils/personality-report.ts": "性格报告生成逻辑",
    "Dockerfile": "容器化配置",
    "docker-compose.yml": "多容器编排"
  },
  
  "coding_patterns": {
    "component_structure": "函数式组件 + TypeScript 接口",
    "api_routes": "Next.js App Router API 路由模式",
    "state_management": "React hooks + Supabase 实时订阅",
    "error_handling": "try-catch + 用户友好的错误消息",
    "data_fetching": "fetch API + React Query (部分)",
    "styling": "Tailwind CSS 类名 + Ant Design 组件",
    "authentication": "基于手机号的无密码认证",
    "database_access": "Supabase 客户端 + RLS 策略"
  },
  
  "business_logic": {
    "core_features": [
      "用户注册/登录 (手机号验证)",
      "个人信息管理",
      "八字排盘分析",
      "AI 性格报告生成",
      "智能对话系统",
      "兑换码管理"
    ],
    "data_flow": [
      "用户输入 → 验证 → Supabase 存储",
      "用户信息 → 八字计算 → Coze AI → 报告生成",
      "对话消息 → Coze API → 实时响应"
    ],
    "key_integrations": [
      "腾讯云 SMS (短信验证)",
      "Coze AI (智能对话和报告生成)",
      "Supabase (数据库和实时功能)",
      "lunar-javascript (农历转换)"
    ]
  },
  
  "development_guidelines": {
    "code_style": "ESLint + Prettier (Next.js 默认)",
    "naming_conventions": {
      "components": "PascalCase (UserProfile.tsx)",
      "functions": "camelCase (getUserData)",
      "constants": "UPPER_SNAKE_CASE (API_BASE_URL)",
      "files": "kebab-case (user-profile.ts)"
    },
    "best_practices": [
      "使用 TypeScript 接口定义数据结构",
      "API 路由包含错误处理和日志记录",
      "组件保持单一职责原则",
      "使用 Supabase RLS 确保数据安全",
      "环境变量管理敏感配置"
    ]
  },
  
  "deployment": {
    "containerization": "Docker + docker-compose",
    "environment": "Alibaba Cloud",
    "database": "Supabase Cloud",
    "cdn": "Next.js 内置优化",
    "monitoring": "日志文件 + 健康检查端点"
  }
}
