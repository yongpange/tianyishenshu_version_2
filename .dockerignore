# 天乙神数项目 Docker忽略文件
# 排除不必要的文件和目录，减少镜像大小

# 依赖目录
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js 构建产物
.next/
out/

# 生产构建
build/
dist/

# 环境变量文件（敏感信息）
.env
# .env.local
.env.development.local
.env.test.local
.env.production.local

# 日志文件
*.log
logs/

# 运行时文件
*.pid
*.seed
*.pid.lock

# 覆盖率报告
coverage/
.nyc_output

# 依赖锁定文件（已在package.json中）
yarn.lock
# package-lock.json

# IDE和编辑器文件
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git相关
.git/
.gitignore
.gitattributes

# 测试文件
__tests__/
**/*.test.js
**/*.test.ts
**/*.test.tsx
**/*.spec.js
**/*.spec.ts
**/*.spec.tsx

# 文档文件
README.md
CHANGELOG.md
LICENSE
*.md

# Docker相关
Dockerfile*
docker-compose*.yml
.dockerignore

# 临时文件
tmp/
temp/

# 缓存目录
.cache/
.parcel-cache/

# Supabase本地开发文件
supabase/.branches
supabase/.temp

# 脚本文件（开发用）
# scripts/

# 文档目录
docs/
